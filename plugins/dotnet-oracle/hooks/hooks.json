{
  "description": "dotnet-oracle agent'ları başladığında ve bittiğinde görev klasörüne durum kaydı yazar (agentlar.jsonl, agentlar.json). Ayrıca görev panelini (panel/panel.tsx) yükler. Model token'ı harcamaz.",
  "modules": [
    "../panel/panel.tsx"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/durum.mjs\" basladi || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/durum.mjs\" bitti || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
